        ],
        "properties": {
          "risk_id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "cost_estimate": {
            "type": "string"
          },
          "timeline": {
            "type": "string"
          }
        }
      }
    },
    "optimizations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "suggestion",
          "expected_impact"
