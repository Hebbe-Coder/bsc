{
  "type": "object",
  "required": [
    "workflow_id",
    "swimlanes",
    "nodes",
    "edges"
  ],
  "properties": {
    "workflow_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "swimlanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "swimlane",
          "label",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "swimlane": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "action",
              "decision",
              "start",
              "end",
              "wait"
            ]
          },
          "sla_hours": {
            "type": "number"
          },
          "metrics": {
            "type": "object"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          }
        }
      }
    }
  }
}