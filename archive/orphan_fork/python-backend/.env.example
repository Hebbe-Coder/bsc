API_HOST=0.0.0.0
API_PORT=8000

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Qianwen (Alibaba) API
QIANWEN_API_KEY=your_qianwen_api_key
QIANWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Doubao (Volcengine) API
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3

# Yuanbao (Tencent) API
YUANBAO_API_KEY=your_yuanbao_api_key
YUANBAO_API_BASE=https://api.yuanbao.tencent.com/v1

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434

# vLLM (Local)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL_NAME=qwen2-7b

# LocalAI (Local)
LOCALAI_BASE_URL=http://localhost:8080/v1
LOCALAI_MODEL_NAME=qwen2

# OpenAI API
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_BASE=https://api.openai.com/v1

# Redis
REDIS_URL=redis://localhost:6379/0

# Caching
CACHE_TTL_DEFAULT=3600
CACHE_TTL_SHORT=600
CACHE_TTL_MEDIUM=1800
CACHE_TTL_LONG=86400

# LLM Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60