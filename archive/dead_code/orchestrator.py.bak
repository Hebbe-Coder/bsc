"""
Agent Orchestrator - Agent编排器

串联执行9个Agent，输出Business Report

Phase 1流程：
    Upload Agent
        ↓
    Document Parser Agent
        ↓
    Semantic Agent
        ↓
    Business Compiler Agent
        ↓
    Process Blueprint Agent
        ↓
    Metrics Agent
        ↓
    Risk Agent
        ↓
    Quality Review Agent
        ↓
    Business Report Agent
"""
from __future__ import annotations
import time, uuid
from app.agents.base import AgentContext
from app.agents.upload_agent import UPLOAD_AGENT, Document
from app.agents.document_parser_agent import DOCUMENT_PARSER_AGENT, ParsedDocument
import logging
from app.agents.semantic_agent import SEMANTIC_AGENT, SemanticAnalysis

logger = logging.getLogger(__name__)
from app.agents.business_compiler_agent import BUSINESS_COMPILER_AGENT, BusinessSystem
from app.agents.remaining_agents import (
    PROCESS_BLUEPRINT_AGENT, METRICS_AGENT, RISK_AGENT,
    QUALITY_REVIEW_AGENT, BUSINESS_REPORT_AGENT, BusinessReport
)


class AgentOrchestrator:
    """Agent编排器 - 串联执行9个Agent"""
    
    # Agent执行顺序
    AGENT_CHAIN = [
        UPLOAD_AGENT,
        DOCUMENT_PARSER_AGENT,
        SEMANTIC_AGENT,
        BUSINESS_COMPILER_AGENT,
        PROCESS_BLUEPRINT_AGENT,
        METRICS_AGENT,
        RISK_AGENT,
        QUALITY_REVIEW_AGENT,
        BUSINESS_REPORT_AGENT,
    ]
    
    def run(self, input_text: str, config: dict = None) -> BusinessReport:
        """执行完整Agent链"""
        t0 = time.perf_counter()
        
        # 创建上下文
        config = config or {}
        context = AgentContext(
            input_text=input_text,
            config=config,
            run_id=str(uuid.uuid4())[:12],
            project_name=config.get("project_name", "Business Analysis")
        )
        
        # 依次执行Agent
        results = []
        for agent in self.AGENT_CHAIN:
            result = agent.execute(context)
            results.append(result)
            
            if not result.ok():
                # Agent失败，记录错误并继续或终止
                logger.error(f"[Orchestrator] Agent {agent.name} failed: {result.error}")
                # 关键Agent失败则终止
                if agent.name in ["upload", "business_compiler"]:
                    break
        
        # 从context获取最终报告
        total_ms = int((time.perf_counter() - t0) * 1000)
        
        # 如果business_report_agent成功，返回其输出
        if results[-1].ok() and results[-1].data:
            return BusinessReport(**results[-1].data)
        
        # 否则构建基础报告
        return BusinessReport(
            report_id=context.run_id,
            system_id=context.business_system.system_id if context.business_system else "",
            title="Business System Report",
            executive_summary="部分Agent执行失败",
            business_system=context.business_system.model_dump() if context.business_system else {},
            quality_report=context.quality_report,
            created_at=time.strftime("%Y-%m-%dT%H:%M:%S"),
            total_processing_time_ms=total_ms,
            agent_trace=context.agent_trace
        )
    
    def run_partial(self, input_text: str, start_agent: str, config: dict = None) -> dict:
        """从指定Agent开始执行"""
        context = AgentContext(
            input_text=input_text,
            config=config or {},
            run_id=str(uuid.uuid4())[:12]
        )
        
        # 找到起始Agent
        start_idx = 0
        for i, agent in enumerate(self.AGENT_CHAIN):
            if agent.name == start_agent:
                start_idx = i
                break
        
        # 从起始Agent执行
        results = []
        for agent in self.AGENT_CHAIN[start_idx:]:
            result = agent.execute(context)
            results.append({"agent": agent.name, "status": result.status.value, "data": result.data})
            
            if not result.ok():
                break
        
        return {
            "run_id": context.run_id,
            "results": results,
            "final_context": context.model_dump()
        }


# 全局编排器实例
ORCHESTRATOR = AgentOrchestrator()


def compile_business_system_from_prd(prd: str, config: dict = None) -> BusinessReport:
    """便捷入口：PRD → Business System"""
    return ORCHESTRATOR.run(prd, config)