# ============================================================
# BSC Backend - 环境变量示例 (复制为 .env 后填入真实值)
# 所有密钥仅存在于你的 .env / .env.private，已被 .gitignore 排除，绝不提交。
# ============================================================

# ---- 服务 ----
APP_NAME=BSC Engine
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=5.0.0
ENVIRONMENT=development          # development | production
LOG_LEVEL=info
API_KEY=                          # 生产环境必填；开发环境可留空(放行全部)

# ---- MCP 子进程隔离 ----
MCP_API_KEY=                      # 配置后 MCP HTTP/SSE 必须使用 Bearer 或 X-API-Key
BSC_MCP_MAX_MEM_MB=1024           # Windows Job Object / POSIX 子进程内存上限
BSC_MCP_MAX_CPU_SEC=600            # 子进程 CPU 时间上限
BSC_MCP_TIMEOUT_SEC=600            # 子进程调用超时
BSC_MCP_FORCE_MOCK=0               # 离线验证时设为 1，强制所有 MCP 模型提供方使用 mock

# ---- LLM 提供方 ----
# 顶层 provider；ANALYSIS_PROVIDER / GENERATION_PROVIDER 可为不同模型做按阶段路由
LLM_PROVIDER=mock                 # mock | deepseek | doubao | qwen | ollama
ANALYSIS_PROVIDER=deepseek        # SOP/Risk/Strategy/Optimization 阶段
GENERATION_PROVIDER=doubao        # Business Understanding / Report 阶段
SOP_LLM_PROVIDER=deepseek         # SOP AI 摘要/优化建议段使用的真实 LLM（enable_ai_analysis=True 时生效）
RAG_LLM_PROVIDER=deepseek         # 知识库问答生成使用的真实 LLM（检索仍需 EMBEDDING_PROVIDER 配置向量 key）

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=ep-2024xxxx

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# ---- 数据库 / 缓存 ----
DB_TYPE=sqlite                     # sqlite | postgresql
DB_PATH=./data/bsc.db
DB_URL=                            # postgresql 时填写
# Stateful Docker services stay on the private Compose network. Use
# `docker compose exec postgres psql ...` for local administration.
POSTGRES_DB=bsc
POSTGRES_USER=bsc
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
CACHE_TYPE=memory                  # memory | redis
REDIS_URL=redis://:replace-with-a-long-random-password@localhost:6379

# Frontend development proxy. Use http://127.0.0.1:18082 for the local
# bsc-growth-e2e Docker profile, or keep port 8000 for a locally run API.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Optional development-only authorization for the Vite proxy. Set this in an
# ignored local environment file or process environment, never as a VITE_* key.
# The browser receives only a boolean local-proxy marker; Vite keeps this value.
BSC_LOCAL_API_KEY=

# ---- Project-scoped LLM Wiki ----
KNOWLEDGE_WIKI_ENABLED=false
KNOWLEDGE_OBSIDIAN_SYNC_ENABLED=false
KNOWLEDGE_SCHEDULES_ENABLED=false
CELERY_KNOWLEDGE_QUEUE=bsc_knowledge
KNOWLEDGE_GROWTH_ENABLED=false
# Enables LLM-written daily/weekly distillation only when a real provider is configured.
KNOWLEDGE_GROWTH_SEMANTIC_DISTILLATION_ENABLED=false
# n8n discovery is opt-in. Generate a distinct 32+ byte secret; never reuse
# BSC API keys or provider credentials for this HMAC value.
KNOWLEDGE_INTELLIGENCE_ENABLED=false
KNOWLEDGE_INTELLIGENCE_INGRESS_SIGNING_SECRET=
# n8n is local-only and runs only with `docker compose --profile n8n up -d`.
# Keep the project ingress key in an ignored local environment file.
N8N_PORT=5678
N8N_ENCRYPTION_KEY=
N8N_BSC_PROJECT_INGRESS_KEY=
# n8n resolves enabled RSS/YouTube Channel RSS sources from BSC at runtime.
# Do not duplicate feed URLs, registry IDs, or project IDs in this file.
N8N_BSC_SOURCE_MANIFEST_URL=http://bsc-backend:8000/knowledge/intelligence/n8n/source-manifest
# Legacy one-feed fields are only for an already-imported pre-manifest workflow.
N8N_BSC_PROJECT_ID=
N8N_BSC_RSS_REGISTRY_ID=
N8N_RSS_FEED_URL=
KNOWLEDGE_TESSERACT_PATH=
KNOWLEDGE_FFPROBE_PATH=
KNOWLEDGE_MCP_WRITE_ENABLED=false
KNOWLEDGE_WIKI_AUTO_PUBLISH_ENABLED=false
OBSIDIAN_VAULT_ROOT=
# The local AI-project workspace is mounted read-only at /workspace in the
# Compose API container. PBOS captures only approved paths as hashes and a
# Git revision; source contents, .env files, and credentials stay excluded.
PBOS_WORKSPACE_HOST_PATH=.
HORIZON_ENABLED=false
HORIZON_API_BASE_URL=
HORIZON_API_KEY=
HORIZON_RUNS_HOST_PATH=./data/horizon-runs
HORIZON_RUNS_ROOT=/horizon-runs
HORIZON_STAGE_URL_TEMPLATE=/api/runs/{run_id}/stages/{stage}
HORIZON_TIMEOUT_SECONDS=20
HORIZON_MAX_RESPONSE_BYTES=2000000
HORIZON_ALLOW_PRIVATE_NETWORK=false
KNOWLEDGE_WIKI_LLM_PROVIDER=
KNOWLEDGE_WIKI_LLM_TIMEOUT_SECONDS=90
KNOWLEDGE_WIKI_LLM_MAX_ATTEMPTS=1
KNOWLEDGE_GROWTH_LLM_MODEL=
KNOWLEDGE_GROWTH_LLM_TIMEOUT_SECONDS=150
KNOWLEDGE_GROWTH_TASK_SOFT_TIMEOUT_SECONDS=390
KNOWLEDGE_GROWTH_TASK_TIMEOUT_SECONDS=420
KNOWLEDGE_SOURCE_SYNC_RECOVERY_TIMEOUT_SECONDS=900

# ---- 安全 / 限流 ----
ALLOWED_ORIGINS=["http://localhost:8000"]
SIGNATURE_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory           # redis in multi-worker production
RATE_LIMIT_RATE=10
RATE_LIMIT_BURST=20
MAX_FILE_SIZE_MB=20
