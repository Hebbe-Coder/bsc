# ============================================================
# BSC Backend - 环境变量示例 (复制为 .env 后填入真实值)
# 所有密钥仅存在于你的 .env / .env.private，已被 .gitignore 排除，绝不提交。
# ============================================================

# ---- 服务 ----
APP_NAME=BSC Engine
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=5.0.0
ENVIRONMENT=development          # development | production
LOG_LEVEL=info
API_KEY=                          # 生产环境必填；开发环境可留空(放行全部)

# ---- LLM 提供方 ----
# 顶层 provider；ANALYSIS_PROVIDER / GENERATION_PROVIDER 可为不同模型做按阶段路由
LLM_PROVIDER=mock                 # mock | deepseek | doubao | qwen | ollama
ANALYSIS_PROVIDER=deepseek        # SOP/Risk/Strategy/Optimization 阶段
GENERATION_PROVIDER=doubao        # Business Understanding / Report 阶段

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=ep-2024xxxx

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# ---- 数据库 / 缓存 ----
DB_TYPE=sqlite                     # sqlite | postgresql
DB_PATH=./data/bsc.db
DB_URL=                            # postgresql 时填写
CACHE_TYPE=memory                  # memory | redis
REDIS_URL=redis://localhost:6379

# ---- 安全 / 限流 ----
ALLOWED_ORIGINS=*
SIGNATURE_ENABLED=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RATE=10
RATE_LIMIT_BURST=20
MAX_FILE_SIZE_MB=20
