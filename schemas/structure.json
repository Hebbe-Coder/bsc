{
  "type": "object",
  "required": [
    "system_id",
    "objective",
    "actors",
    "workflow",
    "states",
    "rules",
    "exceptions"
  ],
  "properties": {
    "system_id": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string"
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "responsibilities"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "workflow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step",
          "actor",
          "action",
          "next"
        ],
        "properties": {
          "step": {
            "type": "integer"
          },
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "next": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "sla_hours": {
            "type": "number"
          }
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "transitions"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "is_initial": {
            "type": "boolean"
          },
          "is_terminal": {
            "type": "boolean"
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "to",
                "trigger"
              ],
              "properties": {
                "to": {
                  "type": "string"
                },
                "trigger": {
                  "type": "string"
                },
                "guard": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "condition",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "exception": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "trigger",
          "path"
        ],
        "properties": {
          "trigger": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "fallback": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}